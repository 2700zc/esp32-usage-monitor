// ESP32 用量监视器 —— 配置文件
//
// 改完本文件后必须重新烧写文件系统才会生效（注意别和固件上传写在一条命令里，
// 两者同时指定时文件系统上传会顶掉固件上传且不报错）：
//     pio run -e esp32-usage-monitor -t uploadfs --upload-port COM5
//
// 任意一项留空 = 不显示该服务商的页面（页面总数自动减少，滑动切页照常可用）。
// 留空只影响界面显示，不影响其他服务商。
//
// 注：本文件是带 // 注释的 JSON。设备端靠 -DARDUINOJSON_ENABLE_COMMENTS=1
// （见 platformio.ini）才认这些注释，删掉那个编译选项会导致整个配置读取失败。
{
  // ────────────── DeepSeek ──────────────
  // 平台 Bearer token，不含 "Bearer " 前缀（不要带前缀，否则会 401）。
  // 获取：登录 platform.deepseek.com/usage
  //   → F12 → 网络 → 刷新 → 点任意 api/v0/ 开头的请求
  //   → 请求头 authorization 里 "Bearer " 后面的部分
  // 注意：这是网页登录态 token，有有效期，过期后该页显示"未配置 token"或获取失败。
  "ds_token": "你的 DeepSeek Bearer token",

  // ────────────── OpenCode Go ──────────────
  // 两种凭据二选一，填了 oc_api_key 就优先用它（推荐，长期有效）：
  //
  // ① oc_api_key（推荐）：Go 套餐的 API key，形如 oc_sk_xxxxx_xxxxx。
  //    获取：opencode.ai 控制台 → Go / API keys 页面生成。
  //    填了它就不需要 workspace_id 和 cookie。
  //
  // ② oc_workspace_id + oc_cookie（备选）：浏览器会话，会过期。
  //    oc_workspace_id : 控制台地址里的 wrk_XXXXXXXX
  //                      （https://opencode.ai/console/wrk_XXX/models）
  //    oc_cookie       : 填「__Host-console_session=st_xxxx...」这一段就够了；
  //                      整串 cookie、或浏览器 Copy as cURL 出来的整条命令也行，
  //                      固件会自己把 session 挑出来。
  //    获取：F12 → 网络 → 刷新 → 找到 /console/api/go/status 请求 → 请求头 Cookie
  //    注意：旧的 auth=Fe26.2** 已失效（_server 接口现在只回 302 跳登录页），不要填那个。
  //    session 或 key 失效时该页显示"凭据已失效"，重新复制填进来并重刷文件系统即可。
  "oc_api_key": "",
  "oc_workspace_id": "",
  "oc_cookie": "",

  // ────────────── CommandCode ──────────────
  // 只填 cookie 的【值】，不要带 cookie 名。
  // 获取：登录 commandcode.ai → F12 → 应用(Application) → Cookie
  //   → 找到 __Secure-commandcode_prod_.session_token，复制它的值
  // 浏览器复制出来的值是 URL 编码的（含 %2F、%3D），原样填入即可。
  "cc_cookie": "你的 CommandCode 会话 token",

  // ────────────── ZCode 状态（PC 上的桥接进程） ──────────────
  // 让屏幕显示 ZCode 此刻在做什么：正在思考 / 执行工具 / 等待授权 / 思考完成。
  // 填 PC 的局域网地址，端口默认 8787。两步：
  //   1) PC 上装一次 hook：python tools/agent-bridge/install-hooks.py
  //   2) PC 上常驻桥接：  python tools/agent-bridge/bridge.py
  //      （启动时会直接把这一行打印出来，粘过来即可）
  // PC 换网络、甚至换一台电脑之后，都不用再改这里：板子会在局域网里自己找桥接
  // （跨网段时退化成按这个地址所在的 /24 逐个问）。填上仍然更好——开机第一次就
  // 直连成功，不用等发现过程，这个地址也正好是"该扫哪个网段"的种子。
  "agent_url": "http://192.168.1.10:8787/agent"
}
